# Next.js side (put real values in .env.local)
# From `npx convex dev` / the Convex dashboard:
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# The rest of the configuration lives in Convex environment variables,
# set with `npx convex env set NAME value`:
#
#   SITE_URL                  http://localhost:3000 (for auth redirects)
#   R2_ENDPOINT               https://<account-id>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID          from a Cloudflare R2 API token
#   R2_SECRET_ACCESS_KEY      from a Cloudflare R2 API token
#   R2_BUCKET                 presenton-artifacts
#   MODAL_SUBMIT_URL          https://<workspace>--presenton-worker-submit.modal.run
#   MODAL_PROXY_TOKEN_ID      wk-... (Modal proxy auth token)
#   MODAL_PROXY_TOKEN_SECRET  ws-...
#   MODAL_CALLBACK_SECRET     long random string, shared with the Modal secret
