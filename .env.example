# Presenton self-hosting configuration
# Copy this file to `.env` next to docker-compose.yml, fill in the values you
# need, then run:  docker compose up -d production
# Every variable here is forwarded by docker-compose.yml. Leave a variable
# blank (or delete the line) to use the app default.

# ── Basics ────────────────────────────────────────────────────────────────────
# Host port to serve the app on (open http://localhost:<port>)
PRESENTON_HTTP_HOST_PORT=5001
# Set to false to lock API keys so they can't be viewed/changed from the UI
CAN_CHANGE_KEYS=true

# ── Primary administrator (first boot) ───────────────────────────────────────
# Creates the admin account unattended. Username >= 3 chars, password >= 8.
# You can instead leave these blank and follow the setup screen in the browser.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password
# One-time flags for credential rotation / recovery (remove after use):
# AUTH_OVERRIDE_FROM_ENV=true
# RESET_AUTH=true

# ── Text LLM provider ────────────────────────────────────────────────────────
# One of: openai / deepseek / google / vertex / azure / bedrock / openrouter /
#         fireworks / together / cerebras / anthropic / litellm / lmstudio /
#         ollama / custom / codex
LLM=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google (Gemini via API key)
GOOGLE_API_KEY=
GOOGLE_MODEL=

# Ollama (local models; from Docker use host.docker.internal)
OLLAMA_URL=
OLLAMA_MODEL=
START_OLLAMA=false

# Any OpenAI-compatible endpoint (vLLM, LM Studio, LiteLLM gateway, etc.)
CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_MODEL=

# Other providers (uncomment / fill as needed — see README "Deployment
# Configurations" for the full list and defaults):
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_MODEL=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL=
# BEDROCK_AWS_ACCESS_KEY_ID=
# BEDROCK_AWS_SECRET_ACCESS_KEY=
# FIREWORKS_API_KEY=
# FIREWORKS_MODEL=
# TOGETHER_API_KEY=
# TOGETHER_MODEL=
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# LITELLM_MODEL=gpt-4.1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=
# VERTEX_API_KEY=
# VERTEX_MODEL=gemini-2.5-flash
# CODEX_MODEL=

# ── Images on slides ─────────────────────────────────────────────────────────
# One of: pexels / pixabay / gemini_flash / nanobanana_pro / dall-e-3 /
#         gpt-image-1.5 / comfyui / open_webui
# Pexels and Pixabay are free stock-photo APIs — easiest way to start.
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=
# PIXABAY_API_KEY=
# DALL_E_3_QUALITY=standard
# GPT_IMAGE_1_5_QUALITY=medium
# COMFYUI_URL=
# COMFYUI_WORKFLOW=
# OPEN_WEBUI_IMAGE_URL=
# OPEN_WEBUI_IMAGE_API_KEY=
# Or turn slide images off entirely:
# DISABLE_IMAGE_GENERATION=true
ENABLE_PARALLEL_IMAGE_GENERATION=true

# ── Web search grounding (optional) ──────────────────────────────────────────
# WEB_GROUNDING=true
# WEB_SEARCH_PROVIDER=auto        # auto / native / searxng / tavily / exa
# WEB_SEARCH_MAX_RESULTS=5
# SEARXNG_BASE_URL=
# TAVILY_API_KEY=
# EXA_API_KEY=

# ── Database (optional) ──────────────────────────────────────────────────────
# Defaults to SQLite inside ./app_data. Set a SQLAlchemy URL for Postgres etc.
# DATABASE_URL=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Disable anonymous usage telemetry
DISABLE_ANONYMOUS_TRACKING=true
# DISABLE_THINKING=false
# EXTENDED_REASONING=false
